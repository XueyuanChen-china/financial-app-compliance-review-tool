# Copy this file to .env and fill in local-only values.
# Never commit the real .env file or paste API keys into source control.
OPENAI_API_KEY=
COMPLIANCE_REVIEW_MODEL=gpt-5.6-luna
COMPLIANCE_REVIEW_BASE_URL=http://8.137.80.16:8083/v1/chat/completions
COMPLIANCE_REVIEW_REASONING_EFFORT=high
COMPLIANCE_REVIEW_TIMEOUT_SECONDS=180
COMPLIANCE_REVIEW_ACTOR_AUTHORIZATION=local-image-extension
# Phase 2 compilation is bounded separately from Reviewer execution.
COMPLIANCE_COMPILATION_REASONING_EFFORT=low
COMPLIANCE_COMPILATION_TIMEOUT_SECONDS=120
COMPLIANCE_COMPILATION_STRUCTURED_MODE=json_schema
# Use json_object only for a relay that rejects the Control schema; Pydantic
# and deterministic semantic validation remain mandatory after the response.
COMPLIANCE_CONTROL_STRUCTURED_MODE=json_schema
